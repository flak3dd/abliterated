# Copy to spark-image/.env and spark/.env on the Spark host. Never commit tokens.
HF_TOKEN=

# Image — Diffusers OpenAI bridge (:7860). Build D hero = Krea 2 RAW.
SAMPLER_BACKEND=diffusers
FLUX_MODEL_ID=krea2-raw-fp8
IMAGE_MODEL_ID=krea2-raw-fp8
KREA_RAW_REPO=krea/Krea-2-Raw
HUIHUI_TE_REPO=huihui-ai/Huihui-Qwen3-VL-4B-Instruct-abliterated
# Image TE (Huihui Qwen3-VL-4B) ≠ LLM sidecar below.
ABLITERATED_IMAGE_HOST=127.0.0.1
ABLITERATED_IMAGE_PORT=7860
FLUX_DTYPE=bfloat16
SAMPLER_STEPS=24
SAMPLER_GUIDANCE=3.5
SAMPLER_SAMPLER=euler
SAMPLER_SCHEDULER=beta
SAMPLER_LORA_STRENGTH=0.75
SAMPLER_MAX_EDGE=1536

# Optional text LLM sidecar (vLLM) — only with install.sh --with-text
# Priority: (1) THe-Plague NVFP4 default (2) AEON-7 heretic twin (3) YuYu1015 Huihui int4
IMAGE=vllm/vllm-openai:cu130-nightly
MODEL_REPO=THe-Plague/Qwen3.6-35B-A3B-abliterated-NVFP4-MTP
MODEL_DIR=./models/Qwen3.6-35B-A3B-abliterated-NVFP4-MTP
PORT=8000
SERVED_NAME=qwen-abliterated
GPU_MEMORY_UTILIZATION=0.6
