# Copy to spark-image/.env and spark/.env on the Spark host. Never commit tokens.
HF_TOKEN=

# Optional: Civitai API token for uncensor LoRA fallback only.
# Prefer HuggingFace mirror (no auth). Never use wget for Civitai (401 prompts).
CIVITAI_API_TOKEN=

# Image (uncensored FLUX.2 Klein only)
ABLITERATED_IMAGE_HOST=0.0.0.0
ABLITERATED_IMAGE_PORT=7860
FLUX_BASE_REPO=black-forest-labs/FLUX.2-klein-base-4B
FLUX_TEXT_ENCODER_REPO=PinoCookie/Flux.2-klein-4B-abliterated-text-encoder
FLUX_MODEL_ID=krea2-raw-fp8
FLUX_DTYPE=bfloat16
FLUX_STEPS=8
COMFY_STEPS=24
COMFY_CFG=3.5
COMFY_SAMPLER=euler
COMFY_SCHEDULER=beta
COMFY_LORA_STRENGTH=0.75
COMFY_URL=http://127.0.0.1:8188
COMFY_PORT=8188

# Optional text (vLLM) — only used with install.sh --with-text
IMAGE=vllm/vllm-openai:cu130-nightly
MODEL_REPO=THe-Plague/Qwen3.6-35B-A3B-abliterated-NVFP4-MTP
MODEL_DIR=./models/Qwen3.6-35B-A3B-abliterated-NVFP4-MTP
PORT=8000
SERVED_NAME=qwen-abliterated
GPU_MEMORY_UTILIZATION=0.6
