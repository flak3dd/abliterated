# Copy to .env on the DGX Spark host (never commit real tokens).
# Gated Hugging Face repos need a token + accepted model terms:
#   https://huggingface.co/settings/tokens
# Public THe-Plague Qwen NVFP4 currently pulls without one.
# HF_TOKEN=
IMAGE=vllm/vllm-openai:cu130-nightly
# Optional Spark-only ARM64 image:
# IMAGE=ghcr.io/aeon-7/aeon-vllm-ultimate:latest
MODEL_REPO=THe-Plague/Qwen3.6-35B-A3B-abliterated-NVFP4-MTP
MODEL_DIR=./models/Qwen3.6-35B-A3B-abliterated-NVFP4-MTP
PORT=8000
SERVED_NAME=qwen-abliterated
GPU_MEMORY_UTILIZATION=0.6
# Optional vLLM agent model (shares :8000 with Qwen — one at a time):
# GPT_OSS_MODEL_REPO=batsclamp/Huihui-gpt-oss-120b-mxfp4-abliterated
# GPT_OSS_MODEL_DIR=./models/Huihui-gpt-oss-120b-mxfp4-abliterated
# GPT_OSS_SERVED_NAME=gpt-oss-120b-abliterated
# GPT_OSS_GPU_MEMORY_UTILIZATION=0.70
