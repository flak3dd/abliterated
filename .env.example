# VITE_ABLITERATED_TOKEN=
# VITE_ABLITERATED_BASE_URL=https://api.abliteration.ai/v1
# VITE_ABLITERATED_MODEL=abliterated-model
# DGX_SPARK_URL=http://127.0.0.1:8000
# Local admin account (DEV). Defaults: admin / abliterated
# VITE_ABLITERATED_ADMIN_USER=admin
# VITE_ABLITERATED_ADMIN_PASSWORD=abliterated
# Platform LiteLLM gateway (OpenAI-compatible /v1). Default production site proxy or dedicated host.
# VITE_PLATFORM_GATEWAY_URL=https://abliterated.app/api/v1
# Spark GPU host only (optional): Civitai LoRA fallback if HF fails — prefer HF; see spark-image/.env.example
# CIVITAI_API_TOKEN=
# Optional xAI Grok Imagine image gen (Images → Endpoint → xAI Imagine). Paste in the app; do not bake into VITE_*.
# XAI_API_KEY=
